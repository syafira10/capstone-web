# Django Settings
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (uncomment for PostgreSQL)
# DATABASE_URL=postgresql://user:password@localhost:5432/capstone

# MQTT Configuration
MQTT_BROKER_HOST=broker.emqx.io
MQTT_BROKER_PORT=1883
MQTT_CLIENT_ID=django-flood-monitor

# Alert Thresholds (in cm for water level, mm/h for rain)
WATER_LEVEL_THRESHOLD_WARNING=60
WATER_LEVEL_THRESHOLD_CRITICAL=70
RAIN_INTENSITY_THRESHOLD_WARNING=50
